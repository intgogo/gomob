# Gradle
.gradle/
build/
!gradle-wrapper.jar
local.properties

# IntelliJ / Android Studio
.idea/
*.iml
*.iws
*.ipr
captures/

# 构建产物 / 日志统一进 .dev/
.dev/

# CodeGraph 索引：数据固定在 .dev/codegraph/，根目录 .codegraph 只是软链
.codegraph

# 本地编译的 Go 开发服务器二进制
server/devserver

# Android
*.apk
*.aab
*.ap_
*.dex
*.class

# NDK
.cxx/
.externalNativeBuild/

# Keystore
*.jks
*.keystore
release.properties

# OS
.DS_Store
Thumbs.db

# Worktree
.worktrees/

# Berxel SDK 二进制由厂商发布单独下发，不进库（jar/.so/PDF 都来自
# /root/WindowsR/berxel/BerxelSDK-Android-9.9.190/，按 README 投放即可）
third_party/berxel-android/libs/*.jar
third_party/berxel-android/libs/*.jar.orig
third_party/berxel-android/jniLibs/**/*.so
third_party/berxel-android/docs/*.pdf
!third_party/berxel-android/libs/.gitkeep
!third_party/berxel-android/jniLibs/.gitkeep
!third_party/berxel-android/docs/.gitkeep

# VINCreator(com.vin.uvc / eYs3D) APK 逆向参考资产：厂商二进制，体积大且可从 APK
# 重新解压，不入库。保留 README.md + AndroidManifest.txt（小文本，记录出处与清单）。
tests/vincreator-apk/*.apk
tests/vincreator-apk/extracted/

# Python（harness analyzer）
__pycache__/
*.pyc
.venv/

# 临时
*.swp
*.tmp
*~
.VSCodeCounter
.kotlin/

# 本地 agent 状态/设置（不入库）
.claude/

# Go 编译产物（laserworker 可执行）
/server/laserworker

# 服务端 native C++ cmake 构建产物（liblidar_*.a / *.o / 可执行）
server/native/**/build/

# 第三方 libuvc 上游源码克隆(含自身 .git，仅用于本地重编 .so；产物 .so 已 track)
third_party/libuvc-android/src/
